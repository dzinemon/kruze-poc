# Sanity
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production

# Used by next-app and astro-app to read from Sanity
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production

# Used by migration scripts to write to Sanity
SANITY_WRITE_TOKEN=your_write_token

# Deploy hooks for the Studio deploy widget
# Staging hooks target the `dev` branch; production hooks target `main`
# Set these in apps/studio/.env.local — never commit real URLs
SANITY_STUDIO_DEPLOY_HOOK_STAGING_VERCEL=https://api.vercel.com/v1/integrations/deploy/your_staging_hook
SANITY_STUDIO_DEPLOY_HOOK_STAGING_CF=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your_staging_hook
SANITY_STUDIO_DEPLOY_HOOK_PRODUCTION_VERCEL=https://api.vercel.com/v1/integrations/deploy/your_production_hook
SANITY_STUDIO_DEPLOY_HOOK_PRODUCTION_CF=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your_production_hook

# Staging draft content — set SANITY_IS_STAGING=true on staging deployments only
# Next.js: auto-enables draft mode so sanityFetch() uses perspective: 'drafts'
# Astro: switches sanityClient to perspective: 'drafts' at build time
# Production deployments must NOT set SANITY_IS_STAGING (or set it to false)
SANITY_IS_STAGING=false
SANITY_API_READ_TOKEN=your_viewer_token

# Studio Presentation Tool preview URL — points the Preview button at the correct frontend
# Local: leave unset (falls back to http://localhost:3000)
# Staging Studio: set to your staging Vercel URL
# Production Studio: set to your production URL
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
