---
export const prerender = true;

import Base from "../layouts/base.astro";
---

<Base title="Page not found — Kruze POC">
  <div class="max-w-container-lg mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-black text-body mb-4">Page not found</h1>
    <p class="text-secondary mb-8">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="inline-block px-4 py-3 bg-primary text-white rounded-btn hover:bg-primary-dark transition-colors"
    >
      Go home
    </a>
  </div>
</Base>
