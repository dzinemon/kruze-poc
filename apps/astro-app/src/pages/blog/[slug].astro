---
export const prerender = true;

import Base from "../../layouts/base.astro";
import PortableTextHybrid from "../../components/portable-text-hybrid.astro";
import BlogSidebar from "../../components/blog/blog-sidebar.astro";
import BlogBreadcrumbs from "../../components/blog/blog-breadcrumbs.astro";
import BlogAuthorMeta from "../../components/blog/blog-author-meta.astro";
import RelatedPostsSection from "../../components/blog/related-posts-section.astro";
import SanityImage from "../../components/sanity-image.astro";
import { sanityClient, imageBuilder } from "../../lib/sanity";
import { blogPostQuery } from "@kruze-poc/groq-queries";
import type { BlogPost } from "@kruze-poc/sanity-schemas/src/types";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<{ slug: { current: string } }[]>(
    `*[_type == "blogPost"]{ slug }`
  );
  return posts.map((p) => ({ params: { slug: p.slug.current } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<BlogPost>(blogPostQuery, { slug });
if (!post) return Astro.redirect("/404");

const authorImageUrl = post.author?.image?.asset
  ? imageBuilder.image(post.author.image).width(96).height(96).url()
  : null;

const categoryIds = post.topicCategories?.map((c) => c._id) ?? [];
const tagIds = post.topicTags?.map((t) => t._id) ?? [];
---

<Base title={`${post.title} — Kruze POC`} description={post.description}>
  <article>
    <BlogBreadcrumbs title={post.title} />

    <div class="max-w-7xl mx-auto px-4 sm:px-4 py-8 lg:py-12">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 xl:gap-12">

        <!-- Main content -->
        <div class="min-w-0">
          <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-primary mb-6">
            {post.headlineText}
          </h1>

          <BlogAuthorMeta
            author={post.author}
            authorImageUrl={authorImageUrl}
            date={post.date}
            modifiedDate={post.modifiedDate}
          />

          {post.heroImage?.asset && (
            <div class="relative rounded-md overflow-hidden mb-8 aspect-video">
              <SanityImage
                image={post.heroImage}
                alt={post.heroImage?.alt || post.title}
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                sizes="(max-width: 1024px) 100vw, 65vw"
              />
            </div>
          )}

          {post.body && <PortableTextHybrid value={post.body} />}

          {post.topicCategories && post.topicCategories.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-divider">
              <span class="text-sm font-bold text-secondary mr-2">Categories:</span>
              {post.topicCategories.map((cat) => (
                <a
                  href="#"
                  class="px-3 py-1 text-xs font-black bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 rounded-full border border-brand-200 dark:border-brand-800 hover:bg-brand-100 transition-fast"
                >
                  {cat.title}
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:sticky lg:top-8 self-start">
          <BlogSidebar />
        </div>

      </div>
    </div>

    <RelatedPostsSection
      currentSlug={post.slug.current}
      categoryIds={categoryIds}
      tagIds={tagIds}
    />
  </article>
</Base>
