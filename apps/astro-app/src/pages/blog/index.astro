---
import Base from "../../layouts/base.astro";
import BlogCard from "../../components/blog-card.astro";
import { sanityClient } from "../../lib/sanity";
import { blogPostsListQuery } from "@kruze-poc/groq-queries";
import type { BlogPost } from "@kruze-poc/sanity-schemas/src/types";

const posts = await sanityClient.fetch<BlogPost[]>(blogPostsListQuery);
---

<Base title="Blog — Kruze POC">
  <div class="max-w-container-lg mx-auto px-4 py-16">
    <h1 class="text-4xl font-black text-body mb-8">Blog</h1>

    {posts.length === 0 ? (
      <p class="text-secondary">
        No blog posts yet. Create one in Sanity Studio.
      </p>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    )}
  </div>
</Base>
