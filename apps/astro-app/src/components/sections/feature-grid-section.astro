---
import type { FeatureGridSection as FeatureGridSectionType } from "@kruze-poc/sanity-schemas/src/types";
import { renderPortableTextHtml } from "@kruze-poc/ui/portable-text/to-html";
import { ArrowRight } from "lucide-react";

interface Props {
  section: FeatureGridSectionType;
}

const { section } = Astro.props;
const cols = section.columns ?? 3;
const bgClass = section.background === "light" ? "bg-neutral-50" : "bg-white";

const colsClass: Record<number, string> = {
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
};
const gridCols = colsClass[cols] ?? colsClass[3];

interface PortableBlock {
  _type: string;
  _key: string;
  style?: string;
  children?: { text: string }[];
}

const contentBlocks = (section.content ?? []).filter(
  (b: any) => b._type === "block"
) as PortableBlock[];
---

<section class={`${bgClass} py-20 px-6`}>
  <div class="max-w-6xl mx-auto">
    {contentBlocks.length > 0 && (
      <div class="text-center mb-12 flex flex-col gap-3">
        {contentBlocks.map((b) => {
          const text = (b.children ?? []).map((c) => c.text).join("");
          return b.style === "h2" ? (
            <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-primary">
              {text}
            </h2>
          ) : (
            <p class="text-lg font-normal text-secondary leading-relaxed max-w-2xl mx-auto">
              {text}
            </p>
          );
        })}
      </div>
    )}
    {section.tiles && section.tiles.length > 0 && (
      <div class={`grid ${gridCols} gap-6`}>
        {section.tiles.map((tile) => {
          const bodyHtml = Array.isArray(tile.body) && tile.body.length > 0
            ? renderPortableTextHtml(tile.body)
            : "";
          return (
            <div class="flex flex-col gap-4 p-6 rounded-xl bg-bg-subtle border border-border-subtle hover-lift">
              {tile.icon?.asset?.url && (
                <div
                  class="icon-container icon-container-xl squircle flex-shrink-0"
                  style="background: var(--gradient-brand);"
                >
                  <img
                    src={tile.icon.asset.url}
                    alt=""
                    width={28}
                    height={28}
                    class="object-contain"
                  />
                </div>
              )}
              <div class="flex flex-col gap-2">
                <h3 class="text-xl font-bold text-primary">{tile.title}</h3>
                {bodyHtml && (
                  <div
                    class="prose prose-sm max-w-none prose-headings:font-bold prose-headings:text-primary prose-p:text-base prose-p:font-normal prose-p:text-secondary prose-p:leading-relaxed prose-a:text-brand-500 hover:prose-a:text-brand-600 prose-li:text-secondary prose-li:leading-relaxed"
                    set:html={bodyHtml}
                  />
                )}
              </div>
              {tile.link?.url && tile.link?.text && (
                <a
                  href={tile.link.url}
                  class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-500 hover:text-brand-600 transition-fast focus-ring"
                >
                  {tile.link.text}
                  <ArrowRight client:load width={14} height={14} strokeWidth={1.5} />
                </a>
              )}
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
