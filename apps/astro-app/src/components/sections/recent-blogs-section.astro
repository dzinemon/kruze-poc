---
import { sanityClient } from "../../lib/sanity";
import { recentBlogsByCategoryQuery } from "@kruze-poc/groq-queries";
import type { RecentBlogsSection as RecentBlogsSectionType } from "@kruze-poc/sanity-schemas/src/types";
import { ArrowRight } from "lucide-react";

interface Props {
  section: RecentBlogsSectionType;
}

interface BlogCard {
  _id: string;
  title: string;
  slug: { current: string };
  date: string;
  description?: string;
  heroImage?: { asset?: { url: string } };
  author?: { fullName: string };
}

const { section } = Astro.props;
const categoryId = section.category?._id ?? null;
const limit = section.limit ?? 3;
const bgClass = section.background === "light" ? "bg-neutral-50" : "bg-white";

const posts = await sanityClient.fetch<BlogCard[]>(recentBlogsByCategoryQuery, {
  categoryId,
  limit,
});

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<section class={`${bgClass} py-20 px-6`}>
  <div class="max-w-6xl mx-auto">
    {Array.isArray(section.content) && section.content.length > 0 && (
      <div class="text-center mb-12 flex flex-col gap-3">
        {section.content
          .filter((b: any) => b._type === "block")
          .map((b: any) => {
            const text = (b.children ?? []).map((c: any) => c.text ?? "").join("");
            if (b.style === "h2") {
              return (
                <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-primary">
                  {text}
                </h2>
              );
            }
            return (
              <p class="text-lg font-normal text-secondary leading-relaxed max-w-2xl mx-auto">
                {text}
              </p>
            );
          })}
      </div>
    )}
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug.current}`}
            class="group flex flex-col rounded-md bg-bg-subtle border border-border-subtle shadow-sm hover:shadow-md hover-lift overflow-hidden focus-ring"
          >
            {post.heroImage?.asset?.url && (
              <div class="aspect-video overflow-hidden bg-neutral-100">
                <img
                  src={post.heroImage.asset.url}
                  alt={post.title}
                  width={640}
                  height={360}
                  class="w-full h-full object-cover group-hover:scale-105 duration-300 transition-transform"
                />
              </div>
            )}
            <div class="p-5 flex flex-col gap-2 flex-1">
              <p class="text-xs font-bold text-muted uppercase tracking-wider">
                {formatDate(post.date)}
              </p>
              <h3 class="text-xl font-bold text-primary leading-snug group-hover:text-brand-500 duration-300 transition-transform">
                {post.title}
              </h3>
              {post.description && (
                <p class="text-sm font-normal text-secondary leading-relaxed line-clamp-3">
                  {post.description}
                </p>
              )}
              <div class="mt-auto pt-3 border-t border-border-subtle flex items-center justify-between gap-4">
                <p class="text-xs font-bold text-muted truncate">
                  {post.author?.fullName ?? ""}
                </p>
                <span class="inline-flex items-center gap-1 text-xs font-bold text-brand-500 group-hover:text-brand-600 duration-300 transition-transform shrink-0">
                  Read more
                  <span class="group-hover:translate-x-1 duration-300 transition-transform inline-flex">
                    <ArrowRight client:load width={12} height={12} strokeWidth={1.5} aria-hidden="true" />
                  </span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-muted text-sm">No posts found.</p>
    )}
  </div>
</section>
