---
import type { FlexSectionBlock } from "@kruze-poc/sanity-schemas/src/types";
import { renderPortableTextHtml } from "@kruze-poc/ui/portable-text/to-html";

interface Props {
  section: FlexSectionBlock;
}

const { section } = Astro.props;

const sectionClass = [
  section.paddingStyle ?? "py-20 px-6",
  section.backgroundStyle ?? "bg-base",
].join(" ");

const rows = (section.rows ?? []).map((row) => ({
  key: row._key,
  rowClass: ["flex flex-col md:flex-row gap-8", row.paddingStyle]
    .filter(Boolean)
    .join(" "),
  columns: (row.columns ?? []).map((col) => ({
    key: col._key,
    colClass: [col.columnWidth ?? "flex-1", "min-w-0"].join(" "),
    html: renderPortableTextHtml(col.content ?? []),
    hasContent: col.content && col.content.length > 0,
  })),
}));
---

<section class={sectionClass}>
  <div class="max-w-6xl mx-auto">
    {rows.map((row) => (
      <div class={row.rowClass}>
        {row.columns.map((col) => (
          <div class={col.colClass}>
            {col.hasContent && (
              <div
                class="article-content"
                set:html={col.html}
              />
            )}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
