---
import type { FlexSectionBlock } from "@kruze-poc/sanity-schemas/src/types";
import { renderPortableTextHtml } from "@kruze-poc/ui/portable-text/to-html";

interface Props {
  section: FlexSectionBlock;
}

const { section } = Astro.props;

const sectionClass = [
  section.paddingStyle ?? "py-20 px-6",
  section.backgroundStyle ?? "bg-bg-base",
].join(" ");

const rows = (section.rows ?? []).map((row) => ({
  key: row._key,
  rowClass: ["flex flex-col md:flex-row gap-8", row.paddingStyle]
    .filter(Boolean)
    .join(" "),
  columns: (row.columns ?? []).map((col) => ({
    key: col._key,
    colClass: [col.columnWidth ?? "flex-1", "min-w-0"].join(" "),
    html: renderPortableTextHtml(col.content ?? []),
    hasContent: col.content && col.content.length > 0,
  })),
}));
---

<section class={sectionClass}>
  <div class="max-w-6xl mx-auto">
    {rows.map((row) => (
      <div class={row.rowClass}>
        {row.columns.map((col) => (
          <div class={col.colClass}>
            {col.hasContent && (
              <div
                class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-text-primary prose-p:text-base prose-p:font-normal prose-p:text-text-secondary prose-p:leading-relaxed prose-p:mb-4 prose-headings:mt-6 prose-headings:mb-3 prose-strong:text-text-primary prose-em:text-text-primary prose-code:text-brand-600 prose-code:bg-bg-subtle prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-a:text-brand-500 hover:prose-a:text-brand-600 prose-blockquote:border-brand-500 prose-blockquote:text-text-secondary prose-blockquote:pl-4 prose-ul:text-text-secondary prose-ol:text-text-secondary prose-li:leading-relaxed prose-li:mb-2"
                set:html={col.html}
              />
            )}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
