---
import type { PressLogosBlock } from "@kruze-poc/sanity-schemas/src/types";

interface Props {
  section: PressLogosBlock;
}

const { section } = Astro.props;
---

<section class="py-12 px-6 bg-bg-base">
  <div class="max-w-6xl mx-auto">
    <p class="text-xs text-text-muted mb-6">pressLogosBlock — {section.variant ?? "press"}</p>
    {section.logos && section.logos.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-8">
        {section.logos.map((logo) => (
          <div class="flex items-center">
            {logo.image?.asset ? (
              <img
                src={logo.image.asset.url}
                alt={logo.name ?? ""}
                class="h-8 object-contain grayscale hover:grayscale-0 transition-all"
              />
            ) : (
              <span class="text-sm text-text-secondary font-bold">{logo.name}</span>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
