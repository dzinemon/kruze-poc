---
import type { FaqSection as FaqSectionType } from "@kruze-poc/sanity-schemas/src/types";

interface Props {
  section: FaqSectionType;
}

const { section } = Astro.props;

interface PortableBlock {
  _type: string;
  _key: string;
  style?: string;
  children?: { text: string }[];
}

function extractText(answer: unknown): string {
  if (typeof answer === "string") return answer;
  const blocks = answer as PortableBlock[];
  return blocks
    ?.map((block) => block.children?.map((c) => c.text).join(""))
    .join(" ") || "";
}

const contentBlocks = (section.content ?? []).filter(
  (b: any) => b._type === "block"
) as PortableBlock[];
---

<section class="py-16">
  <div class="max-w-container-lg mx-auto px-4">
    {contentBlocks.length > 0 && (
      <div class="mb-8 flex flex-col gap-3">
        {contentBlocks.map((b) => {
          const text = (b.children ?? []).map((c) => c.text).join("");
          return b.style === "h2" ? (
            <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-text-primary">
              {text}
            </h2>
          ) : (
            <p class="text-lg font-normal text-text-secondary leading-relaxed">
              {text}
            </p>
          );
        })}
      </div>
    )}

    <div class="space-y-4">
      {section.faqs?.map((faq) => (
        <details class="group border border-gray-200 rounded-lg">
          <summary class="cursor-pointer px-6 py-4 font-bold text-body hover:text-primary transition-colors list-none flex items-center justify-between">
            {faq.question}
            <span class="text-muted group-open:rotate-180 transition-transform">&#9662;</span>
          </summary>
          <div class="px-6 pb-4 text-secondary">
            <p>{extractText(faq.answer)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
