---
import type { CustomEmbedBlock } from "@kruze-poc/sanity-schemas/src/types";

interface Props {
  section: CustomEmbedBlock;
}

const { section } = Astro.props;
---

<section class="py-16 px-6 bg-bg-base">
  <div class="max-w-6xl mx-auto">
    <div class="rounded-md border border-dashed border-border-default p-8 text-center">
      <p class="text-xs text-text-muted mb-2">customEmbedBlock</p>
      <p class="text-base font-bold text-text-primary">
        Custom Embed: <code class="font-normal">{section.embedId}</code>
      </p>
    </div>
  </div>
</section>
