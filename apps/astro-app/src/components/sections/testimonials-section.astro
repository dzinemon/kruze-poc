---
import type { TestimonialsSection as TestimonialsSectionType } from "@kruze-poc/sanity-schemas/src/types";
import SanityImage from "../sanity-image.astro";

interface Props {
  section: TestimonialsSectionType;
}

const { section } = Astro.props;
---

<section class="py-16 bg-gray-50">
  <div class="max-w-container-lg mx-auto px-4">
    {section.heading && (
      <h2 class="text-3xl font-black text-body mb-8 text-center">
        {section.heading}
      </h2>
    )}

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {section.testimonials?.map((t) => (
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <blockquote class="text-secondary italic mb-4">
            &ldquo;{t.quoteText}&rdquo;
          </blockquote>

          <div class="flex items-center gap-3">
            {t.contactImage?.asset && (
              <SanityImage
                image={t.contactImage}
                alt={t.name}
                class="w-10 h-10 rounded-full object-cover"
                fixedWidth={40}
                fixedHeight={40}
              />
            )}
            <div>
              <p class="font-bold text-body text-sm">{t.name}</p>
              {t.role && (
                <p class="text-xs text-dim">
                  {t.role}{t.company && `, ${t.company}`}
                </p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
