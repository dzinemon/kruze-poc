---
import type { TextSection as TextSectionType } from "@kruze-poc/sanity-schemas/src/types";
import PortableTextHybrid from "../portable-text-hybrid.astro";

interface Props {
  section: TextSectionType;
}

const { section } = Astro.props;

const bgClasses: Record<string, string> = {
  white: "bg-white",
  light: "bg-gray-50",
  gradient: "bg-gradient-to-b from-gray-50 to-white",
};

const bg = bgClasses[section.background || "white"];
---

<section class={`py-16 ${bg}`}>
  <div class="max-w-container-lg mx-auto px-4">
    {section.heading && (
      <h2 class="text-3xl font-black text-body mb-8">{section.heading}</h2>
    )}

    {section.body && (
      <PortableTextHybrid value={section.body} />
    )}
  </div>
</section>
