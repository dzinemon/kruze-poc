---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
    <ol class="flex items-center gap-1 text-sm flex-wrap">
      <li>
        <a href="/" class="text-text-muted hover:text-brand-500 transition-fast focus-ring rounded-sm">
          Home
        </a>
      </li>
      <li aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          class="text-text-muted">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </li>
      <li>
        <a href="/blog" class="text-text-muted hover:text-brand-500 transition-fast focus-ring rounded-sm">
          Blog
        </a>
      </li>
      <li aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          class="text-text-muted">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </li>
      <li aria-current="page" class="max-w-xs truncate text-text-secondary font-bold">
        {title}
      </li>
    </ol>
  </div>
</nav>
