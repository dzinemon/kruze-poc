---
interface Props {
  title: string;
  articles: Array<{ title: string; href: string }>;
}

const { title, articles } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-lg p-6">
  <h3 class="text-lg font-black text-body mb-4">{title}</h3>
  <ul class="space-y-3">
    {
      articles.map((article) => (
        <li>
          <a
            href={article.href}
            class="text-sm text-primary hover:text-primary-dark hover:underline"
          >
            {article.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
