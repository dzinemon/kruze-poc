---
interface Props {
  title: string;
  articles: Array<{ title: string; href: string }>;
}

const { title, articles } = Astro.props;
---

<div class="rounded-md bg-bg-subtle border border-border-subtle p-5">
  <h3 class="text-xs font-black tracking-wide uppercase text-muted mb-3">{title}</h3>
  <ul class="space-y-3">
    {
      articles.map((article, index) => (
        <li class={index > 0 ? "border-t border-border-subtle pt-3" : ""}>
          <a
            href={article.href}
            class="text-sm text-brand-500 hover:text-brand-600 transition-fast focus-ring rounded-sm"
          >
            {article.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
