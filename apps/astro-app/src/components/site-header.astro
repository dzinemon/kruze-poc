---
import { sanityClient } from "../lib/sanity";
import { siteNavigationQuery } from "@kruze-poc/groq-queries";
import type { SiteNavigation } from "@kruze-poc/sanity-schemas/src/types";

const nav = await sanityClient.fetch<SiteNavigation>(siteNavigationQuery);
---

<header class="sticky top-0 z-50 bg-base border-b border-divider">
  {nav?.infoBar?.enabled && (
    <div class="bg-brand-800 text-white text-center text-xs md:text-sm py-1 md:px-4 px-2">
      <span>{nav.infoBar.text}</span>
      {nav.infoBar.linkUrl && (
        <a
          href={nav.infoBar.linkUrl}
          class="ml-2 font-bold underline hover:no-underline"
        >
          {nav.infoBar.linkText} →
        </a>
      )}
    </div>
  )}

  <nav class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16" aria-label="Main navigation">
    <a href="/" class="text-xl font-black text-primary flex-shrink-0">Kruze POC</a>

    {nav?.navItems && nav.navItems.length > 0 ? (
      <ul class="hidden lg:flex items-center gap-1" role="list">
        {nav.navItems.map((item) => (
          <li class="relative group">
            {item.url ? (
              <a
                href={item.url}
                class="relative px-3 py-2 text-sm font-bold text-primary hover:text-brand-500 transition-fast focus-ring rounded-sm inline-flex items-center gap-1"
              >
                {item.title}
                {(item.dropdownColumns?.length ?? 0) > 0 && (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                )}
              </a>
            ) : (
              <button
                class="relative px-3 py-2 text-sm font-bold text-primary hover:text-brand-500 transition-fast focus-ring rounded-sm inline-flex items-center gap-1"
                aria-expanded="false"
              >
                {item.title}
                {(item.dropdownColumns?.length ?? 0) > 0 && (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                )}
              </button>
            )}

            {item.dropdownColumns && item.dropdownColumns.length > 0 && (
              <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 z-50 hidden group-hover:block">
                <div class="bg-base border border-divider rounded-md shadow-lg min-w-[620px] p-6">
                  <div
                    class="grid gap-6"
                    style={`grid-template-columns: repeat(${item.dropdownColumns.length}, minmax(0, 1fr))`}
                  >
                    {item.dropdownColumns.map((col) => (
                      <div>
                        {col.featured && col.featuredImage?.asset?.url ? (
                          <div>
                            {col.heading && (
                              <p class="text-xs font-bold uppercase tracking-wider text-secondary mb-2">
                                {col.heading}
                              </p>
                            )}
                            <a
                              href={col.featuredImageUrl ?? "#"}
                              class="block relative rounded-md overflow-hidden border border-divider hover:border-brand-500 transition-fast"
                            >
                              <img
                                src={col.featuredImage.asset.url}
                                alt={col.heading ?? "Featured"}
                                class="w-full object-cover"
                                width="255"
                                height="160"
                                loading="lazy"
                              />
                              {col.featuredImageLinkText && (
                                <div class="mt-2 text-center">
                                  <span class="inline-block text-xs font-bold text-white bg-brand-500 px-3 py-1 rounded-full">
                                    {col.featuredImageLinkText}
                                  </span>
                                </div>
                              )}
                            </a>
                          </div>
                        ) : (
                          <div>
                            {col.heading && (
                              <p class="text-xs font-bold uppercase tracking-wider text-secondary mb-2">
                                {col.heading}
                              </p>
                            )}
                            <ul class="space-y-1">
                              {col.navLinks?.map((link) => (
                                <li>
                                  <a
                                    href={link.url}
                                    class="group/link flex flex-col py-1 hover:text-brand-500 transition-fast"
                                  >
                                    <span class="text-sm font-bold text-primary group-hover/link:text-brand-500">
                                      {link.title}
                                    </span>
                                    {link.helpText && (
                                      <span class="text-xs text-secondary">{link.helpText}</span>
                                    )}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>

                  {item.dropdownInfoBar?.text && (
                    <div class="mt-4 pt-4 border-t border-divider text-center">
                      <a
                        href={item.dropdownInfoBar.linkUrl ?? "#"}
                        class="text-sm font-bold text-brand-500 hover:text-brand-600 transition-fast"
                      >
                        {item.dropdownInfoBar.text}
                        {item.dropdownInfoBar.linkText && ` — ${item.dropdownInfoBar.linkText}`}
                      </a>
                    </div>
                  )}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="hidden lg:flex items-center gap-6">
        <a href="/blog" class="text-sm font-bold text-secondary hover:text-primary transition-fast">Blog</a>
        <a href="/landing" class="text-sm font-bold text-secondary hover:text-primary transition-fast">Pages</a>
      </div>
    )}

    <div class="flex items-center gap-3">
      {nav?.phoneNumber && (
        <a
          href={`tel:${nav.phoneNumber.replace(/\D/g, "")}`}
          class="hidden lg:inline text-sm font-bold text-primary hover:text-brand-500 transition-fast"
        >
          {nav.phoneNumber}
        </a>
      )}
      {nav?.ctaButton?.text && (
        <a
          href={nav.ctaButton.url ?? "/free-consultation"}
          class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold text-white rounded-full bg-brand-500 hover:bg-brand-600 shadow-sm hover:shadow-brand transition-fast focus-ring"
        >
          {nav.ctaButton.text}
        </a>
      )}
      <button
        id="theme-toggle"
        class="icon-container icon-container-md squircle bg-muted hover:bg-emphasis text-primary transition-fast focus-ring"
        aria-label="Toggle dark mode"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("theme-toggle") as HTMLButtonElement;
  const sun = document.getElementById("icon-sun") as HTMLElement | null;
  const moon = document.getElementById("icon-moon") as HTMLElement | null;

  function syncIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    if (sun) sun.style.display = isDark ? "block" : "none";
    if (moon) moon.style.display = isDark ? "none" : "block";
    btn.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
  }

  syncIcons();

  btn.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncIcons();
  });
</script>
