---
import { renderPortableTextHtml } from "@kruze-poc/ui/portable-text/to-html";
import { buildChartJsonConfig, getChartAspectRatio } from "@kruze-poc/ui/chart";
import ChartIsland from "./react/chart-island";
import YouTubeIsland from "./react/youtube-island";

interface Props {
  value: unknown[];
}

const { value } = Astro.props;

// Group consecutive non-interactive blocks together for better HTML rendering
const segments: Array<{ type: "html" | "chart" | "youtube"; content: any }> = [];
let currentHtmlBlocks: any[] = [];

value.forEach((block: any) => {
  if (block._type === "chartReference") {
    // Flush any accumulated HTML blocks
    if (currentHtmlBlocks.length > 0) {
      segments.push({
        type: "html",
        content: renderPortableTextHtml(currentHtmlBlocks),
      });
      currentHtmlBlocks = [];
    }
    // Normalize chartReference to the same shape as chartBlock
    // Guard: chart ref must be fully resolved (has _id and options)
    if (block._type === "chartReference" && block.chart && block.chart._id && block.chart.options) {
      const jsonConfig = buildChartJsonConfig(block.chart);
      segments.push({
        type: "chart",
        content: {
          jsonConfig,
          title: block.chart.title,
          aspectRatio: getChartAspectRatio(block.chart.options),
        },
      });
    }
    // Skip unresolved chart references silently
  } else if (block._type === "youtubeBlock") {
    // Flush any accumulated HTML blocks
    if (currentHtmlBlocks.length > 0) {
      segments.push({
        type: "html",
        content: renderPortableTextHtml(currentHtmlBlocks),
      });
      currentHtmlBlocks = [];
    }
    // Add youtube segment
    segments.push({ type: "youtube", content: block });
  } else {
    // Accumulate non-interactive blocks
    currentHtmlBlocks.push(block);
  }
});

// Flush any remaining HTML blocks
if (currentHtmlBlocks.length > 0) {
  segments.push({
    type: "html",
    content: renderPortableTextHtml(currentHtmlBlocks),
  });
}
---

<div
  class="article-content"
>
  {
    segments.map((segment) => {
      if (segment.type === "html") {
        return <Fragment set:html={segment.content} />;
      }

      if (segment.type === "chart") {
        return (
          <div class="my-8">
            <ChartIsland
              client:load
              jsonConfig={segment.content.jsonConfig}
              title={segment.content.title}
              aspectRatio={segment.content.aspectRatio ?? "4/3"}
            />
          </div>
        );
      }

      if (segment.type === "youtube") {
        return (
          <div>
            <YouTubeIsland
              client:visible
              videoId={segment.content.videoId}
              caption={segment.content.caption}
            />
          </div>
        );
      }

      return null;
    })
  }
</div>
